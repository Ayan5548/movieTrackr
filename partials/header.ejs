<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/style.css">
  
</head>

<body>

 <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
  <div class="container">

    <!-- Logo -->
    <a class="navbar-brand fw-bold" href="/">
      🎬 CineTrackr
    </a>

    <!-- Toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navContent">

      <!-- Center Content -->
      <div class="mx-auto d-flex align-items-center gap-3">

        <!-- Links -->
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>

          <% if(currentUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/movies">My Movies</a>
          </li>
          <% } %>
        </ul>

        <!-- 🔍 Search Bar -->
        <% if(currentUser) { %>
        <form class="d-flex nav-search" action="/movies/search" method="post">
          <input 
            type="text" 
            name="title"
            class="form-control search-input"
            placeholder="Search movies..."
          >
          <button class="btn btn-outline-custom ms-2">
            Search
          </button>
        </form>
        <% } %>

      </div>

      <!-- Right Buttons -->
      <div class="d-flex align-items-center gap-2">

        <% if(currentUser) { %>
          <a href="/movies" class="btn btn-outline-custom">Dashboard</a>
          <a href="/logout" class="btn btn-primary-custom">Logout</a>
        <% } else { %>
          <a href="/login" class="btn btn-outline-custom">Login</a>
          <a href="/register" class="btn btn-primary-custom">Register</a>
        <% } %>

      </div>

    </div>
  </div>
</nav>