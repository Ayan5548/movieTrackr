<%- include('../partials/header') %>

<div class="container py-5 details-page">
  <div class="row justify-content-center align-items-center g-5">

    <!-- 🎬 Poster -->
    <div class="col-md-4 text-center">
      <img src="<%= movied.data.Poster %>" 
           class="img-fluid rounded-4 shadow details-poster" 
           alt="Movie Poster">
    </div>

    <!-- 📄 Details -->
    <div class="col-md-7">
      <div class="details-card p-4">

        <h2 class="fw-bold mb-3 details-title">
          <%= movie.title %>
        </h2>

        <p class="text-muted mb-4 details-plot">
          <%= movied.data.Plot %>
        </p>

        <!-- Info Pills -->
        <div class="d-flex flex-wrap gap-3 mb-4 details-info">

          <div class="details-pill">
            ⭐ <span><%= movied.data.imdbRating %> (imdb)</span>
          </div>

          <div class="details-pill">
            ⭐ <span><%= movie.rating %> (you)</span>
          </div>

          <div class="details-pill">
            📅 <span><%= movied.data.Released %></span>
          </div>

          <div class="details-pill">
            🎬 <span><%= movied.data.Genre %></span>
          </div>

        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-between align-items-center mt-4 details-actions">

          <a href="/movies" class="btn btn-outline-custom px-4">
            ⬅ Back
          </a>

          <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST">
            <button class="btn btn-danger-custom px-4 btn-primary-custom">
              🗑 Delete
            </button>
          </form>

        </div>

      </div>
    </div>

  </div>
</div>

 <%- include('../partials/footer') %>