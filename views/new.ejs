<%- include('../partials/header') %>
  <div class="container d-flex justify-content-center align-items-center min-vh-100 create-page">

  <div class="create-card p-4">

    <h3 class="text-center mb-4 create-title">
      Add New Movie 🎬
    </h3>

    <form action="/movies" method="POST">

      <!-- Title -->
      <div class="mb-3">
        <label class="form-label create-label">Title</label>
        <input 
          type="text" 
          class="form-control create-input" 
          name="title" 
          placeholder="Enter movie title"
          required>
      </div>

      <!-- Rating -->
      <div class="mb-3">
        <label class="form-label create-label">Rating (out of 10)</label>
        <input 
          type="number" 
          class="form-control create-input" 
          name="rating" 
          step="any" 
          max="10"
          placeholder="e.g. 8.5"
          required>
      </div>

      <!-- Date -->
      <div class="mb-3">
        <label class="form-label create-label">Date Watched</label>
        <input 
          type="date" 
          class="form-control create-input" 
          name="watchedDate"
          value="<%= new Date().toISOString().split('T')[0] %>" 
          required>
      </div>

      <!-- Button -->
      <button class="btn btn-primary-custom w-100 mt-2">
         Add Movie
      </button>

    </form>

  </div>

</div>
    <%- include('../partials/footer') %>