<%- include("../partials/header") %>

<div class="container d-flex justify-content-center align-items-center vh-100 auth-page">

  <div class="auth-card p-4">

    <h3 class="text-center mb-4 auth-title">
      Create Account 🎬
    </h3>

    <form action="/register" method="POST">

      <div class="mb-3">
        <label class="form-label auth-label">Username</label>
        <input 
          type="text" 
          name="username" 
          class="form-control auth-input" 
          placeholder="Enter username" 
          required>
      </div>

      <div class="mb-3">
        <label class="form-label auth-label">Email</label>
        <input 
          type="email" 
          name="email" 
          class="form-control auth-input" 
          placeholder="Enter email" 
          required>
      </div>

      <div class="mb-3">
        <label class="form-label auth-label">Password</label>
        <input 
          type="password" 
          name="password" 
          class="form-control auth-input" 
          placeholder="Enter password" 
          required>
      </div>

      <button class="btn btn-primary-custom w-100 mt-2">
        Register
      </button>

    </form>

    <p class="text-center mt-3 auth-footer-text">
      Already have an account? 
      <a href="/login" class="auth-link">Login</a>
    </p>

  </div>
  
</div>
<%- include("../partials/footer") %>