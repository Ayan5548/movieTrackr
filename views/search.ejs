<%- include('../partials/header') %>

     <div class="container py-5 dashboard-page">

  <!-- 🔥 Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 dashboard-header">
    <h2 class="fw-bold">Search results</h2>

  </div>

  <!-- 🎥 Movies Grid -->
  <div class="row g-4 dashboard-grid">

    <% movies.forEach(movie => { %>

      <div class="col-md-4 col-lg-3">
        <div class="dashboard-card h-100 d-flex flex-column">

          <!-- 📌 Top -->
          <div class="dashboard-card-top d-flex justify-content-between align-items-center">
            <span class="dashboard-movie-title text-truncate">
              <%= movie.title %>
            </span>

            <% if(movie.watched) { %>
              <span class="dashboard-watched-badge">👀</span>
            <% } %>
          </div>

          <!-- 📊 Body -->
          <div class="dashboard-card-body flex-grow-1">

            <p class="mb-2">
              ⭐ <strong><%= movie.rating %>/10</strong>
            </p>

            <p class="text-muted small">
              📅 <%= movie.watchedDate.toISOString().split('T')[0] %>
            </p>

          </div>

          <!-- 🔘 Footer -->
          <div class="dashboard-card-footer d-flex justify-content-between align-items-center">

            <form action="/movies/<%= movie._id %>?_method=PUT" method="POST" class="m-0">
              <input type="hidden" name="watched" value="<%= !movie.watched %>">
              <button class="btn btn-outline-custom btn-sm">
                Toggle
              </button>
            </form>

            <a href="/movies/<%= movie._id %>" class="btn btn-primary-custom btn-sm">
              Details
            </a>

          </div>

        </div>
      </div>

    <% }) %>

  </div>
</div>

    <%- include('../partials/footer') %>